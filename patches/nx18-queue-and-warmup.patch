--- /dev/null
+++ b/dm/gfx/nvn/nvn_present_trim.h
@@ -0,0 +1,15 @@
+#pragma once
+#include <stdint.h>
+
+// NX18's standing-frame trim, adapted from 1ac14cbb and ce221c00.
+// Call when a display tick can take a new present. Held ticks leave the
+// counter alone. A gap, a mode change, or a tick with no spare frame resets it.
+static inline uint64_t nvn_present_trim(uint64_t first, uint64_t last, int fifo,
+                                        unsigned limit, unsigned *standing) {
+    if (!fifo || !limit || first >= last) *standing = 0;
+    else if (++*standing >= limit) {
+        *standing = 0;
+        return last;
+    }
+    return fifo && last > first ? (last - first >= 2 ? last - 1 : first) : last;
+}
